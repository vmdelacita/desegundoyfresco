---
import { formatearFecha, migasDeZona, tituloCorto, urlVia, type Via } from '../lib/vias';

interface Props {
  via: Via;
  /** h2 en los listados; h3 cuando la tarjeta va dentro de otra sección (entrada anterior y siguiente). */
  nivel?: 'h2' | 'h3';
}
const { via, nivel = 'h2' } = Astro.props;
const Titulo = nivel;
const { titulo, grado, longitud, roca, portada, fecha } = via.data;
const zona = migasDeZona(via).at(-1);
---

<article class="tarjeta">
  <a class="foto" href={urlVia(via)} tabindex="-1" aria-hidden="true">
    <img src={portada} alt="" loading="lazy" width="720" height="480" />
    <span class="grado">{grado}</span>
  </a>
  <p class="zona">{zona?.nombre}</p>
  <Titulo><a href={urlVia(via)}>{tituloCorto(titulo)}</a></Titulo>
  <p class="meta">
    {longitud && <>{longitud} m · </>}{roca} · <time datetime={fecha.toISOString()}>{formatearFecha(fecha)}</time>
  </p>
</article>

<style>
  .foto { position: relative; display: block; aspect-ratio: 3 / 2; overflow: hidden; background: var(--fondo-suave); }
  .foto img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .tarjeta:hover .foto img { transform: scale(1.04); }
  .grado { position: absolute; top: 0; left: 0; padding: 8px 14px; background: var(--velo); color: #fff; font: 700 24px/1 var(--etiquetas); letter-spacing: 0.03em; }
  .zona { margin: 16px 0 4px; color: var(--acento); font: 600 14px/1.2 var(--etiquetas); letter-spacing: 0.14em; text-transform: uppercase; }
  h2, h3 { margin: 0; font: 800 clamp(19px, 1.7vw, 22px)/1.3 var(--nombres); letter-spacing: 0.02em; text-transform: uppercase; }
  h2 a, h3 a { color: var(--texto); text-decoration: none; }
  h2 a:hover, h3 a:hover { color: var(--acento); }
  .meta { margin: 8px 0 0; color: var(--suave); font-size: 15px; }
  @media (prefers-reduced-motion: reduce) { .foto img { transition: none; } }
</style>

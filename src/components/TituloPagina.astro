---
// Cabecera de las páginas sin foto: zonas, etiquetas, autores, archivo…
interface Props {
  titulo: string;
  /** Texto pequeño sobre el título: «Zona», «Etiqueta»… */
  etiqueta?: string;
  /** Línea bajo el título: «12 vías». */
  detalle?: string;
  /** Enlace para volver al nivel superior. */
  atras?: { titulo: string; url: string };
}
const { titulo, etiqueta, detalle, atras } = Astro.props;
---

<header class="contenedor titulo-pagina">
  {atras && <a class="atras" href={atras.url}>← {atras.titulo}</a>}
  {etiqueta && <p class="etiqueta">{etiqueta}</p>}
  <h1>{titulo}</h1>
  {detalle && <p class="detalle">{detalle}</p>}
</header>

<style>
  .titulo-pagina { padding-top: 48px; padding-bottom: 8px; }
  .atras { font: 600 15px/1 var(--etiquetas); letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; }
  .etiqueta { margin: 18px 0 8px; color: var(--acento); font: 600 16px/1 var(--etiquetas); letter-spacing: 0.14em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(48px, 8.4vw, 92px); font-weight: 500; line-height: 1; }
  .atras + h1 { margin-top: 18px; }
  .detalle { margin: 14px 0 0; color: var(--suave); }
</style>

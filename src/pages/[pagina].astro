---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TituloPagina from '../components/TituloPagina.astro';
import Comentarios from '../components/Comentarios.astro';

// Páginas fijas en la raíz, como en WordPress: /quienes-somos/, /como-monto-reuniones/…
export async function getStaticPaths() {
  const paginas = await getCollection('paginas');
  return paginas.map((pagina) => ({ params: { pagina: pagina.id }, props: { pagina } }));
}

const { pagina } = Astro.props;
const { Content } = await render(pagina);
---

<Base titulo={pagina.data.titulo}>
  <div data-pagefind-body>
  {pagina.data.portada
    ? <Hero imagen={pagina.data.portada} titulo={pagina.data.titulo} nivel="h1" />
    : <TituloPagina titulo={pagina.data.titulo} />}
  <div class="contenedor">
    <div class="columna texto" style="margin-top: 48px">
      <Content />
    </div>
    <Comentarios comentarios={pagina.data.comentarios} />
  </div>
  </div>
</Base>

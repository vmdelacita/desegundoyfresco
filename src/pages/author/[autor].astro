---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TituloPagina from '../../components/TituloPagina.astro';
import TarjetaVia from '../../components/TarjetaVia.astro';
import { todasLasVias } from '../../lib/vias';

// /author/<usuario>/, como en WordPress. Solo se generan los autores con alguna vía publicada.
export async function getStaticPaths() {
  const [autores, vias] = await Promise.all([getCollection('autores'), todasLasVias()]);
  return autores
    .map((autor) => ({ autor, vias: vias.filter((v) => v.data.autor.id === autor.id) }))
    .filter((a) => a.vias.length > 0)
    .map(({ autor, vias }) => ({ params: { autor: autor.id }, props: { nombre: autor.data.nombre, vias } }));
}

const { nombre, vias } = Astro.props;
---

<Base titulo={`Vías de ${nombre}`}>
  <TituloPagina etiqueta="Autor" titulo={nombre} detalle={`${vias.length} ${vias.length === 1 ? 'vía' : 'vías'}`} />
  <div class="contenedor">
    <ul class="rejilla" style="margin-top: 40px">
      {vias.map((via) => <li><TarjetaVia via={via} /></li>)}
    </ul>
  </div>
</Base>

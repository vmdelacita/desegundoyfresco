---
import Base from '../../layouts/Base.astro';
import TituloPagina from '../../components/TituloPagina.astro';
import TarjetaVia from '../../components/TarjetaVia.astro';
import MenuCategorias from '../../components/MenuCategorias.astro';
import { todasLasVias } from '../../lib/vias';
import { totalPaginas, viasDePagina } from '../../lib/paginacion';

// La página 1 es la portada (/); aquí solo van de la 2 en adelante.
export async function getStaticPaths() {
  const vias = await todasLasVias();
  const total = totalPaginas(vias.length);
  return Array.from({ length: Math.max(total - 1, 0) }, (_, i) => {
    const pagina = i + 2;
    return { params: { page: String(pagina) }, props: { pagina, total, vias: viasDePagina(vias, pagina) } };
  });
}

const { pagina, total, vias } = Astro.props;
const anterior = pagina === 2 ? '/' : `/page/${pagina - 1}/`;
---

<Base titulo={`Página ${pagina}`}>
  <TituloPagina titulo="Vías anteriores" detalle={`Página ${pagina} de ${total}`} />
  <div class="contenedor con-lateral">
    <section>
      <ul class="rejilla rejilla-dos" style="margin-top: 40px">
        {vias.map((via) => <li><TarjetaVia via={via} /></li>)}
      </ul>
      <p class="paginacion">
        <a class="boton" href={anterior}>← Más recientes</a>
        {pagina < total ? <a class="boton" href={`/page/${pagina + 1}/`}>Vías anteriores →</a> : <span></span>}
      </p>
    </section>
    <MenuCategorias />
  </div>
</Base>

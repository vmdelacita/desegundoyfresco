---
import Base from '../../layouts/Base.astro';
import TituloPagina from '../../components/TituloPagina.astro';
import TarjetaVia from '../../components/TarjetaVia.astro';
import { todasLasEtiquetas } from '../../lib/vias';

export async function getStaticPaths() {
  const etiquetas = await todasLasEtiquetas();
  return etiquetas.map((e) => ({ params: { tag: e.slug }, props: { nombre: e.nombre, vias: e.vias } }));
}

const { nombre, vias } = Astro.props;
---

<Base titulo={`Etiqueta: ${nombre}`}>
  <TituloPagina etiqueta="Etiqueta" titulo={nombre} detalle={`${vias.length} ${vias.length === 1 ? 'vía' : 'vías'}`} />
  <div class="contenedor">
    <ul class="rejilla" style="margin-top: 40px">
      {vias.map((via) => <li><TarjetaVia via={via} /></li>)}
    </ul>
  </div>
</Base>

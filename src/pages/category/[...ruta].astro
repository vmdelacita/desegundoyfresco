---
import Base from '../../layouts/Base.astro';
import TituloPagina from '../../components/TituloPagina.astro';
import Tesela from '../../components/Tesela.astro';
import TarjetaVia from '../../components/TarjetaVia.astro';
import { todasLasCategorias } from '../../lib/vias';

// Zonas, grados, tipos de piedra y tipos de escalada, con las mismas direcciones que WordPress:
// /category/zona/aragon/ordesa/, /category/grado/6a/, /category/tipo-de-piedra/granito/…
export async function getStaticPaths() {
  const categorias = await todasLasCategorias();
  return categorias.map((categoria) => ({ params: { ruta: categoria.ruta }, props: { categoria } }));
}

const { categoria } = Astro.props;
// Las zonas se muestran como fotos; grados, piedra y tipo, como etiquetas.
const comoFotos = categoria.grupo === 'Zona';
// En la página raíz («Zonas», «Grados»…) no hay vías propias: se cuentan las de sus grupos.
const total = categoria.vias.length || categoria.hijos.reduce((suma, h) => suma + h.total, 0);
const plural = (n: number) => `${n} ${n === 1 ? 'vía' : 'vías'}`;
---

<Base titulo={categoria.titulo}>
  <TituloPagina
    titulo={categoria.titulo}
    etiqueta={categoria.padre ? categoria.grupo : undefined}
    detalle={plural(total)}
    atras={categoria.padre}
  />

  <div class="contenedor">
    {categoria.hijos.length > 0 && comoFotos && (
      <ul class="rejilla teselas">
        {categoria.hijos.map((h) => <li><Tesela titulo={h.titulo} url={h.url} total={h.total} imagen={h.portada} /></li>)}
      </ul>
    )}
    {categoria.hijos.length > 0 && !comoFotos && (
      <ul class="chips">
        {categoria.hijos.map((h) => <li><a href={h.url}>{h.titulo} <span>({h.total})</span></a></li>)}
      </ul>
    )}

    {categoria.vias.length > 0 && (
      <>
        {categoria.hijos.length > 0 && <h2 class="seccion">Todas las vías</h2>}
        <ul class="rejilla" style={categoria.hijos.length === 0 ? 'margin-top: 40px' : undefined}>
          {categoria.vias.map((via) => <li><TarjetaVia via={via} /></li>)}
        </ul>
      </>
    )}
  </div>
</Base>

<style>
  .teselas { margin-top: 40px; }
  .chips { margin-top: 32px; }
</style>
